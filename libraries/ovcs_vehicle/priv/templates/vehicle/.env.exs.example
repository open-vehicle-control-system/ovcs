# `{ssid, psk}` per known network, `[]` for none; must be an Elixir list literal.
System.put_env("WIFI_NETWORKS", ~s([
  {"MyHomeWiFi", "homepassword"},
  {"MyOfficeWiFi", "officepassword"}
]))
System.put_env("AUTHORIZED_SSH_KEYS", Enum.join([
  "key1",
  "key2"
], ","))
System.put_env("SECRET_KEY_BASE", "random_string")
System.put_env("SIGNING_SALT", "random_string")
# Infotainment API on every interface instead of localhost, if the vehicle has one.
# System.put_env("INFOTAINMENT_API_ON_ALL_INTERFACES", "true")
# Zenoh router for ros_bridge, if the vehicle bundles it.
System.put_env("ZENOH_ENDPOINT_IP", "192.168.10.95")
