<?xml version="1.0"?>
<!--
  Gazebo's AckermannSteering system drives the model; the ROS bridge's
  simulated hardware commands it on `/simulator/drive`, bridged from the
  system's default command topic, `/model/ovcs_mini/cmd_vel`, which no
  tag renames. Every geometry value is read from `ovcs_mini.urdf.xacro`'s
  properties. The system's own odometry is not bridged: the bridge owns
  `/odom`, and `OdometryPublisher` gives ground truth on `/simulator/odom`.

  Tag names come from the shipped
  `libgz-sim-ackermann-steering-system.so`: an unrecognised tag is
  ignored without a word.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">

      <!-- Shaft-driven 4WD: all four wheels are driven. `left_joint`
           and `right_joint` are repeatable, which is how the system
           expresses more than one driven axle. Modelling a Slash 4x4
           as rear-drive would understate its traction and change how
           it behaves under power in a corner. -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Only the front pair steers. -->
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>

      <!-- Shared model geometry; unmeasured values are documented in README.md. -->
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- The controller uses the same pivot spacing and achievable turning radius
           as the URDF. See the parameter conversion in ovcs_mini.urdf.xacro. -->
      <kingpin_width>${kingpin_width}</kingpin_width>
      <steering_limit>${gazebo_steering_limit}</steering_limit>
      <!-- Steering joint speed per radian of error, capped by the joint's
           velocity limit. -->
      <steer_p_gain>${steering_servo_gain}</steer_p_gain>

      <!-- ESTIMATE. A stock Slash 4x4 does roughly 30 mph; reverse is
           geared slower. Acceleration limits keep the velocity
           controller from stepping the wheels hard enough to spin
           them on contact. -->
      <min_velocity>-5.0</min_velocity>
      <max_velocity>13.0</max_velocity>
      <min_acceleration>-10.0</min_acceleration>
      <max_acceleration>10.0</max_acceleration>
    </plugin>

    <!-- Ground truth: the model's pose as the physics has it. Its
         transform goes to a topic nothing bridges: the odom frame belongs
         to the odometry Nav2 navigates by. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/simulator/odom</odom_topic>
      <tf_topic>/simulator/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <!-- Joint positions: the simulated hardware measures the wheels from
         them, and robot_state_publisher moves the wheels in a viewer. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <!-- Without it the system publishes every physics step,
           and robot_state_publisher turns each into a /tf message. -->
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
</robot>
