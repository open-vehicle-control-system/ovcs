<?xml version="1.0"?>
<!--
  OVCS Mini — Traxxas Slash 4x4 Ultimate chassis with Pro-Line VW Baja Bug 3238-62 shell.

  Dynamics dimensions are declared here and consumed by the wheel
  macros, Ackermann plugin and inertia tensors. Visual body proportions
  are approximate; see README.md for the dimensional audit.

  ## Where the numbers come from

  Nominal values carried by the model (not measurements of the OVCS build):

    wheelbase   324 mm
    track       296 mm (centre-to-centre in this model; UNVERIFIED)
    tyre        109.5 mm diameter -> 54.75 mm radius
    stock envelope 568 x 296 x 193 mm (not the Baja shell)
    mass        2.41 kg (UNVERIFIED with battery and OVCS equipment)

  The wheel envelope is track + wheel_width = 341 mm, wider than
  body_width = 296 mm. Do not interpret the catalogue's "track" as
  wheel-centre spacing without checking the actual vehicle.

  Estimated values, marked ESTIMATE below, because the specification
  does not publish them: tyre width, chassis-tub dimensions, ground
  clearance, and the mass split between chassis and wheels. These are
  the numbers to revisit first if the vehicle behaves oddly.

  ## Frames

  `base_link` sits on the ground plane, midway between the axles, in
  REP-103 orientation: x forward, y left, z up. Placing it at ground
  level rather than at the chassis makes sensor offsets (the stereo
  bar's height above the ground) read directly off the vehicle.
-->
<robot name="ovcs_mini" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Shared with any other vehicle modelled here; the rest of this
       directory is specific to the Mini. -->
  <xacro:arg name="common_dir" default="../../common" />
  <xacro:include filename="$(arg common_dir)/inertial_macros.xacro" />
  <xacro:include filename="$(arg common_dir)/materials.xacro" />

  <xacro:include filename="wheels.xacro" />
  <xacro:include filename="sensors.xacro" />
  <xacro:include filename="visuals.xacro" />

  <!-- Nominal geometry; unresolved measurements are listed in README.md. -->
  <xacro:property name="wheelbase"     value="0.324" />
  <xacro:property name="track"         value="0.296" />
  <xacro:property name="wheel_radius"  value="0.0548" />
  <xacro:property name="body_length"   value="0.568" />
  <xacro:property name="body_width"    value="0.296" />
  <xacro:property name="total_mass"    value="2.41" />

  <!-- Pro-Line 3238-62 shell dimensions, distinct from the Slash chassis.
       Mounting height is an estimate pending measurement on the OVCS build. -->
  <xacro:property name="shell_length" value="0.489" />
  <xacro:property name="shell_width" value="0.191" />
  <xacro:property name="shell_height" value="0.152" />
  <xacro:property name="shell_mount_z" value="0.045" />

  <!-- ── ESTIMATE: not in the specification ─────────────────────── -->
  <!-- Short-course tyres are wide; 45 mm is eyeballed from the tyre. -->
  <xacro:property name="wheel_width"   value="0.045" />
  <!-- The chassis tub, which is where the mass actually is (battery,
       motor, ESC all sit low in it). Used for collision and inertia;
       the body shell above it is visual only. Modelling the mass as
       the full 193 mm envelope would put the centre of gravity about
       twice as high as the real truck's and roll it over in the
       first corner. -->
  <xacro:property name="tub_length"    value="0.400" />
  <xacro:property name="tub_width"     value="0.200" />
  <xacro:property name="tub_height"    value="0.070" />
  <xacro:property name="ground_clearance" value="0.030" />
  <!-- A mounted Slash 4x4 wheel + tyre is roughly 120 g. -->
  <xacro:property name="wheel_mass"    value="0.12" />
  <xacro:property name="steering_mass" value="0.05" />
  <xacro:property name="camera_mass" value="0.005" />
  <xacro:property name="imu_mass" value="0.005" />

  <!-- ── Derived ────────────────────────────────────────────────── -->
  <xacro:property name="half_wheelbase" value="${wheelbase / 2}" />
  <xacro:property name="half_track"     value="${track / 2}" />
  <!-- Residual mass after all separately modelled links, including sensors. -->
  <xacro:property name="chassis_mass"
                  value="${total_mass - 4 * wheel_mass - 2 * steering_mass - 2 * camera_mass - imu_mass}" />
  <xacro:property name="tub_z" value="${ground_clearance + tub_height / 2}" />
  <!-- Estimated virtual bicycle steering limit, not the inner-wheel joint limit. -->
  <xacro:property name="steering_limit" value="0.52" />
  <!-- Zero scrub radius in this simplified model: pivots coincide with wheel centres. -->
  <xacro:property name="kingpin_width" value="${track}" />
  <xacro:property name="min_turning_radius" value="${wheelbase / tan(steering_limit)}" />
  <xacro:property name="wheel_steering_limit"
    value="${atan(wheelbase / (min_turning_radius - kingpin_width / 2))}" />
  <!-- Gazebo 10 velocity mode uses L / sin(parameter), not L / tan(parameter). -->
  <xacro:property name="gazebo_steering_limit" value="${asin(tan(steering_limit))}" />

  <!-- Stereo geometry; camera height remains an estimate. -->
  <xacro:property name="baseline" value="0.090" />
  <xacro:property name="focal_px" value="${779.54677 * 480 / 640}" />
  <xacro:property name="camera_x" value="${half_wheelbase - 0.120}" />
  <xacro:property name="camera_z" value="0.12" />

  <!-- ── base_link ──────────────────────────────────────────────── -->
  <!-- Deliberately empty. A link with no inertia is the conventional
       root: it is a frame, not a body, and giving it mass would
       double-count the chassis. -->
  <link name="base_link" />

  <!-- ── Chassis ────────────────────────────────────────────────── -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="chassis">
    <!-- Static hardware and optional shell; their mass is included in chassis_mass. -->
    <xacro:mini_visuals />

    <xacro:chassis_tray />

    <!-- Lumped inertia for chassis, electronics and static visual hardware.
         The mass distribution remains an estimate until the vehicle is measured. -->
    <xacro:inertial_box mass="${chassis_mass}"
                        x="${tub_length}" y="${tub_width}" z="${tub_height}">
      <origin xyz="0 0 ${tub_z}" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>

  <!-- ── Wheels ─────────────────────────────────────────────────── -->
  <!-- Shaft-driven 4WD, so all four are driven; only the front pair
       steers. `side` is +1 for left and -1 for right, which is what
       keeps y positive to the left in REP-103 — the old model had the
       rear pair mirrored against the front. -->
  <xacro:fixed_wheel  name="rear_left"   side="1"
                      x="${-half_wheelbase}" />
  <xacro:fixed_wheel  name="rear_right"  side="-1"
                      x="${-half_wheelbase}" />
  <xacro:steered_wheel name="front_left"  side="1"
                       x="${half_wheelbase}" />
  <xacro:steered_wheel name="front_right" side="-1"
                       x="${half_wheelbase}" />

  <!-- ── Sensors ────────────────────────────────────────────────── -->
  <!-- Matches the real vehicle's capture: 480x270 at 30 Hz. The
       resolution is not arbitrary — it is what the stereo pipeline was
       tuned to, trading depth precision at range for a 0.55 m near
       clip and half the SGBM cost. Simulating something else would
       measure a pipeline the vehicle does not run.

       Measured off the vehicle:

         baseline  90 mm, straddling the centreline
         position  120 mm behind the front axle

       The front axle is half a wheelbase ahead of base_link, so the
       bar sits at 162 - 120 = 42 mm forward of it — not the 100 mm
       that was guessed, which put the cameras 58 mm too far forward
       and biased every detection by that much.

       The bar also carries a third, FPV camera between the two. It is
       not modelled: nothing in the perception path reads it. -->

  <!-- From the vehicle's own calibration
       (vehicles/ovcs_mini/priv/calibration/stereo_left.yaml): the
       rectified P gives fx = 779.55 at 640 wide, and the pipeline
       captures at 480, so fx scales to 779.55 * 0.75 = 584.66.

       That is a ~45 degree horizontal field of view, not the ~70 a
       wide-angle module would suggest, and it is what makes the
       simulated depth behave like the real one: f*B = 52.6, so the
       near clip lands at 52.6 / 96 = 0.55 m — the figure the vehicle
       was tuned to. -->
  <!-- TODO: still unmeasured. Lens centre height above the ground. -->

  <!-- Left is +y in REP-103. -->
  <xacro:sim_camera name="stereo_left"  x="${camera_x}" y="${baseline / 2}"
                    z="${camera_z}" topic="stereo/left/image_raw"
                    width="480" height="270" focal_px="${focal_px}" rate="30" />

  <xacro:sim_camera name="stereo_right" x="${camera_x}" y="${-baseline / 2}"
                    z="${camera_z}" topic="stereo/right/image_raw"
                    width="480" height="270" focal_px="${focal_px}" rate="30" />

  <!-- TODO: placeholder, like the camera transform — the BNO085's
       real mounting position has not been measured. Harmless while
       only orientation is consumed. 100 Hz is the BNO085's cadence. -->
  <xacro:sim_imu name="imu" x="0" y="0" z="0.05" rate="100" />

  <xacro:include filename="gazebo_ackermann.xacro" />
</robot>
