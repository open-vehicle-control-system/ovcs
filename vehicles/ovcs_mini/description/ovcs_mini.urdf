  <!-- ── Sensors ────────────────────────────────────────────────── -->
  <!-- Matches the real vehicle's capture: 480x270 at 30 Hz. The
       resolution is not arbitrary — it is what the stereo pipeline was
       tuned to, trading depth precision at range for a 0.36 m near
       clip and half the SGBM cost. Simulating something else would
       measure a pipeline the vehicle does not run.

       Measured off the vehicle:

         baseline  90 mm, straddling the centreline
         position  120 mm behind the front axle
         height    185 mm, the lens centres above the ground

       The front axle is half a wheelbase ahead of base_link, so the
       bar sits at 162 - 120 = 42 mm forward of it — not the 100 mm
       that was guessed, which put the cameras 58 mm too far forward
       and biased every detection by that much.

       The bar also carries a third, FPV camera between the two. It is
       not modelled: nothing in the perception path reads it. -->
  <link name="stereo_left_link">
    <visual>
      <geometry>
        <box size="0.012 0.024 0.012"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="3e-07" ixy="0.0" ixz="0.0" iyy="1.2e-07" iyz="0.0" izz="3e-07"/>
    </inertial>
  </link>
  <joint name="stereo_left_joint" type="fixed">
    <parent link="chassis"/>
    <child link="stereo_left_link"/>
    <origin rpy="0 0 0" xyz="0.04200000000000001 0.045 0.185"/>
  </joint>
  <!-- URDF fixed-axis RPY: roll=-90 degrees, yaw=-90 degrees. -->
  <link name="stereo_left_optical"/>
  <joint name="stereo_left_optical_joint" type="fixed">
    <parent link="stereo_left_link"/>
    <child link="stereo_left_optical"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- Attached to the *mount*, not the optical child, because the
         URDF-to-SDF conversion drops links with no inertia and
         silently reparents their <gazebo> elements — here, all the way
         up to base_link, which puts the camera at the wrong place
         while still rendering happily. The mount has mass, so it
         survives.

         No pose correction is needed: a Gazebo camera looks down +x
         of its own frame, and the mount is body-oriented (x forward),
         so it already points where the vehicle is going. Only the
         reported frame_id has to name the optical frame, for
         consumers that unproject pixels. -->
  <gazebo reference="stereo_left_link">
    <sensor name="stereo_left" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>stereo/left/image_raw</topic>
      <!-- Stamp images with the optical frame, so a consumer that
             unprojects a pixel resolves the ray in the frame the
             pixels were actually taken in. (`gz_frame_id` is the
             deprecated spelling.) -->
      <frame_id>stereo_left_optical</frame_id>
      <camera>
        <!-- Field of view is derived from the *measured* focal
               length rather than chosen, because it is focal length
               that the stereo pipeline actually depends on: the near
               clip is f*B / num_disparities and depth error goes as
               Z^2 / (f*B). A simulator with a plausible-looking FOV
               but the wrong f models a different camera and quietly
               reports different depth behaviour than the vehicle. -->
        <horizontal_fov>1.128941686105897</horizontal_fov>
        <image>
          <width>480</width>
          <height>270</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <!-- Near plane well inside the stereo near clip (0.36 m on
                 the real rig) so the simulation is not the thing that
                 limits close range. -->
          <near>0.02</near>
          <far>100.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <link name="stereo_right_link">
    <visual>
      <geometry>
        <box size="0.012 0.024 0.012"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="3e-07" ixy="0.0" ixz="0.0" iyy="1.2e-07" iyz="0.0" izz="3e-07"/>
    </inertial>
  </link>
  <joint name="stereo_right_joint" type="fixed">
    <parent link="chassis"/>
    <child link="stereo_right_link"/>
    <origin rpy="0 0 0" xyz="0.04200000000000001 -0.045 0.185"/>
  </joint>
  <!-- URDF fixed-axis RPY: roll=-90 degrees, yaw=-90 degrees. -->
  <link name="stereo_right_optical"/>
  <joint name="stereo_right_optical_joint" type="fixed">
    <parent link="stereo_right_link"/>
    <child link="stereo_right_optical"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- Attached to the *mount*, not the optical child, because the
         URDF-to-SDF conversion drops links with no inertia and
         silently reparents their <gazebo> elements — here, all the way
         up to base_link, which puts the camera at the wrong place
         while still rendering happily. The mount has mass, so it
         survives.

         No pose correction is needed: a Gazebo camera looks down +x
         of its own frame, and the mount is body-oriented (x forward),
         so it already points where the vehicle is going. Only the
         reported frame_id has to name the optical frame, for
         consumers that unproject pixels. -->
  <gazebo reference="stereo_right_link">
    <sensor name="stereo_right" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>stereo/right/image_raw</topic>
      <!-- Stamp images with the optical frame, so a consumer that
             unprojects a pixel resolves the ray in the frame the
             pixels were actually taken in. (`gz_frame_id` is the
             deprecated spelling.) -->
      <frame_id>stereo_right_optical</frame_id>
      <camera>
        <!-- Field of view is derived from the *measured* focal
               length rather than chosen, because it is focal length
               that the stereo pipeline actually depends on: the near
               clip is f*B / num_disparities and depth error goes as
               Z^2 / (f*B). A simulator with a plausible-looking FOV
               but the wrong f models a different camera and quietly
               reports different depth behaviour than the vehicle. -->
        <horizontal_fov>1.128941686105897</horizontal_fov>
        <image>
          <width>480</width>
          <height>270</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <!-- Near plane well inside the stereo near clip (0.36 m on
                 the real rig) so the simulation is not the thing that
                 limits close range. -->
          <near>0.02</near>
          <far>100.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <link name="imu_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="6.166666666666666e-08" ixy="0.0" ixz="0.0" iyy="8.333333333333334e-08" iyz="0.0" izz="1.4166666666666668e-07"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>imu_raw</topic>
      <frame_id>imu_link</frame_id>
    </sensor>
  </gazebo>
  <link name="lidar_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="3.3333333333333335e-07" ixy="0.0" ixz="0.0" iyy="3.3333333333333335e-07" iyz="0.0" izz="3.3333333333333335e-07"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="-0.137 0 0.205"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>scan_raw</topic>
      <frame_id>lidar_link</frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>500</samples>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.129026282975434</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <link name="ultrasound_rear_left_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="3.3333333333333335e-07" ixy="0.0" ixz="0.0" iyy="3.3333333333333335e-07" iyz="0.0" izz="3.3333333333333335e-07"/>
    </inertial>
  </link>
  <joint name="ultrasound_rear_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasound_rear_left_link"/>
    <origin rpy="0 0 2.9670597283903604" xyz="-0.2976 0.0418 0.11"/>
  </joint>
  <gazebo reference="ultrasound_rear_left_link">
    <sensor name="ultrasound_rear_left" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>ultrasound/rear_left_raw</topic>
      <frame_id>ultrasound_rear_left_link</frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>13</samples>
            <min_angle>-0.5235987755982988</min_angle>
            <max_angle>0.5235987755982988</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.03</min>
          <max>4.5</max>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <link name="ultrasound_rear_right_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="3.3333333333333335e-07" ixy="0.0" ixz="0.0" iyy="3.3333333333333335e-07" iyz="0.0" izz="3.3333333333333335e-07"/>
    </inertial>
  </link>
  <joint name="ultrasound_rear_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasound_rear_right_link"/>
    <origin rpy="0 0 -2.9670597283903604" xyz="-0.2976 -0.0418 0.11"/>
  </joint>
  <gazebo reference="ultrasound_rear_right_link">
    <sensor name="ultrasound_rear_right" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>ultrasound/rear_right_raw</topic>
      <frame_id>ultrasound_rear_right_link</frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>13</samples>
            <min_angle>-0.5235987755982988</min_angle>
            <max_angle>0.5235987755982988</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.03</min>
          <max>4.5</max>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <!-- Shaft-driven 4WD: all four wheels are driven. `left_joint`
           and `right_joint` are repeatable, which is how the system
           expresses more than one driven axle. Modelling a Slash 4x4
           as rear-drive would understate its traction and change how
           it behaves under power in a corner. -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <!-- Only the front pair steers. -->
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <!-- Shared model geometry; unmeasured values are documented in README.md. -->
      <wheel_base>0.324</wheel_base>
      <wheel_separation>0.296</wheel_separation>
      <wheel_radius>0.0522</wheel_radius>
      <!-- The controller uses the same pivot spacing and achievable turning radius
           as the URDF. See the parameter conversion in ovcs_mini.urdf.xacro. -->
      <kingpin_width>0.296</kingpin_width>
      <steering_limit>0.6096271691822053</steering_limit>
      <!-- Steering joint speed per radian of error, capped by the joint's
           velocity limit. -->
      <steer_p_gain>20.0</steer_p_gain>
      <!-- ESTIMATE. A stock Slash 4x4 does roughly 30 mph; reverse is
           geared slower. Acceleration limits keep the velocity
           controller from stepping the wheels hard enough to spin
           them on contact. -->
      <min_velocity>-5.0</min_velocity>
      <max_velocity>13.0</max_velocity>
      <min_acceleration>-10.0</min_acceleration>
      <max_acceleration>10.0</max_acceleration>
    </plugin>
    <!-- Ground truth: the model's pose as the physics has it. Its
         transform goes to a topic nothing bridges: the odom frame belongs
         to the odometry Nav2 navigates by. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/simulator/odom</odom_topic>
      <tf_topic>/simulator/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <!-- Joint positions: the simulated hardware measures the wheels from
         them, and robot_state_publisher moves the wheels in a viewer. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <!-- Without it the system publishes every physics step,
           and robot_state_publisher turns each into a /tf message. -->
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
</robot>
