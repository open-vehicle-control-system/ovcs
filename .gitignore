.env.exs
vehicles/*/priv/host_keys/
.tool-versions
doc/
*.db
*.db-shm
*.db-wal
_build/
deps/
# ExUnit's @tag :tmp_dir output.
tmp/
*.o
.elixir_ls/
erl_crash.dump
*.ez
.claude/*
!.claude/settings.json

# Nerves system forks cloned locally for development (see systems/README.md).
# Each is its own independent Git repo, not a submodule.
systems/*/
!systems/README.md

# Filled-in NetworkManager keyfiles for the ROS compute node (they hold PSKs).
# The committed templates are the .example files next to them.
compose/compute/host/system-connections/*.nmconnection

# Detection model weights. Fetched by `mise run fetch-models`, never
# vendored: OVCS is MIT and YOLOv8's weights are AGPL-3.0, which the
# MIT grant cannot promise on behalf of. See scripts/models.tsv.
vehicles/*/priv/models/*.hef
vehicles/*/priv/models/*.onnx

# Python bytecode
__pycache__/

# Qualcomm's AI Runtime for the VENTUNO Q vision firmware, written by
# `mise run fetch-qairt`. Qualcomm's licence allows shipping it only inside
# a firmware.
vision/firmware/rootfs_overlay_qairt/

# Generated GPU module caches (mix vision_core.nx_cache)
vehicles/*/priv/nx_iree_cache/

# Fetched by scripts/fetch_models.sh
vehicles/*/priv/models/*.dlc
