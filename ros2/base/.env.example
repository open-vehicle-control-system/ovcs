# Copy to `.env` and adjust. `docker compose` picks `.env` up
# automatically. Base-station side only — the vehicle stack gets its
# configuration from balena fleet/device variables, not from a file.
#
# The Zenoh router the base station peers with. In normal use this is
# the vehicle's ROS compute Pi, which runs `zenohd` under balena and
# is the router for the whole fabric.
ZENOH_ENDPOINT_IP=192.168.10.95

# For vehicle-less development, point at the local `standalone`
# router instead:
#   ZENOH_ENDPOINT_IP=127.0.0.1
#   docker compose --profile standalone up -d

# Only used by the `standalone` foxglove_bridge. With a vehicle
# present, Foxglove Studio connects to ws://<ros-pi-ip>:8765 instead.
FOXGLOVE_BRIDGE_PORT=8765
