# The AX210 as an access point, bridged into the vehicle network.
#
# Channel 149 / 80 MHz requires the wifi_ap_fix service on NetworkManager
# 1.52: it corrects the VHT center to 5775 MHz and limits TX power to
# 6 dBm. Deploy that service before activating this profile.
#
# Requires `"country":"BE"` in /mnt/boot/config.json. Without a country
# the phy sits in regulatory domain 00, where AP mode cannot beacon.
#
# interface-name is the AX210's stable PCI-path name, derived from its
# slot, so probe order cannot change it. The onboard Broadcom radio has
# no such name (wlan0 or wlan1, depending on who registered first),
# which is why uplink.nmconnection matches it by driver instead.
#
[connection]
id=ovcs0-ap
type=wifi
interface-name=wlP1p1s0
master=ovcs0
slave-type=bridge
autoconnect-priority=100
autoconnect-retries=1

[wifi]
mode=ap
band=a
channel=149
channel-width=80
ssid=OVCS-Mini

# proto/pairwise/group are not decoration. Left to itself
# NetworkManager advertises WPA1 alongside WPA2 (a scan shows
# "WPA1 WPA2 WPA3"), and a client that negotiates WPA1/TKIP is barred
# by 802.11n from any HT rate — it falls back to 54 Mbps, which is not
# the link you want under Foxglove. Pinning RSN + CCMP drops WPA1 and
# TKIP entirely.
[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
psk=CHANGE_ME_AP_PSK
