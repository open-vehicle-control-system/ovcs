# Copy to `.env` and adjust. `docker compose` picks `.env` up
# automatically from this directory, for base.yml and simulation.yml
# both. Local stacks only — the vehicle stack (../compute) gets its
# configuration from balena fleet/device variables, not from a file.
#
# The Zenoh router this machine peers with. In normal use this is the
# vehicle's compute node, which runs `zenohd` under balena and is the
# router for the whole fabric.
ZENOH_ENDPOINT_IP=REPLACE_WITH_COMPUTE_NODE_IP

# For vehicle-less development, point at the local `standalone`
# router instead:
#   ZENOH_ENDPOINT_IP=127.0.0.1
#   docker compose -f base.yml --profile standalone up -d

# The vehicle whose compute stack the `nav2` profiles build and run:
# a directory name under vehicles/, not the Elixir module name the
# `VEHICLE` variable takes. Required by base.yml and simulation.yml.
OVCS_VEHICLE=ovcs_mini

# Only used by the `standalone` foxglove_bridge. With a vehicle
# present, Foxglove Studio connects to ws://<compute-node-ip>:8765
# instead.
FOXGLOVE_BRIDGE_PORT=8765
