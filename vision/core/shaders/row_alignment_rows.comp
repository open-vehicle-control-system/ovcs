#version 450
// Stage.RowAlignment's sums for one sampled row, every ROW_STEP-th: for
// each matched pixel of the band-covered columns, |right - left| with the
// right pixel at its disparity on the rows REACH above to REACH below,
// summed per band and row offset, then the matched count, exactly in
// 32-bit integers. Writes the row's [band][offsets..., matched];
// column_sums.comp adds the rows.
//
// WORDS=1 reads 32-bit pixels; WORDS=0 reads 8-bit images as words.
#define GROUP 64
#define BANDS 4
#define REACH 2
#define ROW_STEP 4
#define PLANES (2 * REACH + 2)
layout(local_size_x = GROUP) in;

layout(constant_id = 0) const int WIDTH = 364;
layout(constant_id = 1) const int HEIGHT = 272;

#if WORDS
layout(set = 0, binding = 0) readonly buffer Left { int left_image[]; };
layout(set = 0, binding = 1) readonly buffer Right { int right_image[]; };
int left_pixel(int i) { return left_image[i]; }
int right_pixel(int i) { return right_image[i]; }
#else
layout(set = 0, binding = 0) readonly buffer Left { uint left_words[]; };
layout(set = 0, binding = 1) readonly buffer Right { uint right_words[]; };
int left_pixel(int i) { return int((left_words[i >> 2] >> ((i & 3) * 8)) & 255u); }
int right_pixel(int i) { return int((right_words[i >> 2] >> ((i & 3) * 8)) & 255u); }
#endif
layout(set = 0, binding = 2) readonly buffer Disparity { float disparity[]; };
layout(set = 0, binding = 3) writeonly buffer Partials { float partials[]; };

shared uint sums[BANDS * PLANES][GROUP];

void main() {
  int sampled = int(gl_WorkGroupID.x);
  int y = sampled * ROW_STEP;
  uint t = gl_LocalInvocationID.x;
  int band_width = WIDTH / BANDS;

  uint acc[BANDS * PLANES];
  for (int k = 0; k < BANDS * PLANES; ++k) acc[k] = 0u;

  for (int x = int(t); x < band_width * BANDS; x += GROUP) {
    int i = y * WIDTH + x;
    float d = disparity[i];
    if (!(d > 0.0)) continue;
    int band = x / band_width;
    // Nx.round rounds halves away from zero; d is positive.
    int source = clamp(x - int(floor(d + 0.5)), 0, WIDTH - 1);
    int l = left_pixel(i);
    for (int o = -REACH; o <= REACH; ++o) {
      int row = clamp(y + o, 0, HEIGHT - 1);
      acc[band * PLANES + o + REACH] += uint(abs(right_pixel(row * WIDTH + source) - l));
    }
    acc[band * PLANES + PLANES - 1] += 1u;
  }

  for (int k = 0; k < BANDS * PLANES; ++k) sums[k][t] = acc[k];
  barrier();
  for (uint stride = GROUP / 2; stride > 0u; stride >>= 1) {
    if (t < stride) {
      for (int k = 0; k < BANDS * PLANES; ++k) sums[k][t] += sums[k][t + stride];
    }
    barrier();
  }
  if (t < uint(BANDS * PLANES)) partials[sampled * BANDS * PLANES + int(t)] = float(sums[t][0]);
}
