#version 450
// Stage.SpeckleFilter: a matched pixel stays when at least min_support of
// the 48 others in its 7x7 neighbourhood matched within max_diff of it;
// the others become unmatched, -1. Outside the image counts as unmatched.
// A workgroup covers a TILE x TILE block of pixels, read once into shared
// memory with the RADIUS-pixel border its neighbourhoods reach.
layout(local_size_x = 16, local_size_y = 16) in;

layout(constant_id = 0) const int WIDTH = 364;
layout(constant_id = 1) const int HEIGHT = 272;

layout(set = 0, binding = 0) readonly buffer Disparity { float disparity[]; };
// min_support, max_diff
layout(set = 0, binding = 1) readonly buffer Params { float params[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float despeckled[]; };

const int RADIUS = 3;
const int TILE = 16;
const int SPAN = TILE + 2 * RADIUS;

shared float tile[SPAN * SPAN];

void main() {
  int x0 = int(gl_WorkGroupID.x) * TILE - RADIUS;
  int y0 = int(gl_WorkGroupID.y) * TILE - RADIUS;
  for (int m = int(gl_LocalInvocationIndex); m < SPAN * SPAN; m += TILE * TILE) {
    int x = x0 + m % SPAN, y = y0 + m / SPAN;
    tile[m] = x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT ? disparity[y * WIDTH + x] : -1.0;
  }
  barrier();

  int lx = int(gl_LocalInvocationID.x), ly = int(gl_LocalInvocationID.y);
  int x = x0 + RADIUS + lx, y = y0 + RADIUS + ly;
  if (x >= WIDTH || y >= HEIGHT) return;
  float d = tile[(ly + RADIUS) * SPAN + lx + RADIUS];
  float max_diff = params[1];

  int support = 0;
  for (int dy = 0; dy <= 2 * RADIUS; ++dy) {
    for (int dx = 0; dx <= 2 * RADIUS; ++dx) {
      if (dx == RADIUS && dy == RADIUS) continue;
      float n = tile[(ly + dy) * SPAN + lx + dx];
      if (n > 0.0 && abs(n - d) <= max_diff) support += 1;
    }
  }

  despeckled[y * WIDTH + x] = (d > 0.0 && float(support) >= params[0]) ? d : -1.0;
}
