#version 450
// The sum of each column of a ROWS x COLUMNS f32 matrix, one workgroup a
// column.
#define GROUP 64
layout(local_size_x = GROUP) in;

layout(constant_id = 0) const int ROWS = 272;
layout(constant_id = 1) const int COLUMNS = 6;

layout(set = 0, binding = 0) readonly buffer Matrix { float matrix[]; };
layout(set = 0, binding = 1) writeonly buffer Sums { float sums[]; };

shared float partial[GROUP];

void main() {
  int column = int(gl_WorkGroupID.x);
  uint t = gl_LocalInvocationID.x;
  float acc = 0.0;
  for (int row = int(t); row < ROWS; row += GROUP) acc += matrix[row * COLUMNS + column];
  partial[t] = acc;
  barrier();
  for (uint stride = GROUP / 2; stride > 0u; stride >>= 1) {
    if (t < stride) partial[t] += partial[t + stride];
    barrier();
  }
  if (t == 0u) sums[column] = partial[0];
}
