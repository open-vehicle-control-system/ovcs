#version 450
// NxStereo.Rectify.rectify/3 for one camera: undistorts, rectifies and
// shrinks an 8-bit frame read as 32-bit words, four pixels a word, and
// writes the image four pixels per invocation. The arithmetic follows the
// Nx code's order and is `precise`, so a pixel differs only where a sample
// falls on a rounding half.
//
// WORDS=1 writes the image as 32-bit pixels and as packed words, for a
// device without 8-bit storage; WORDS=0 writes the packed words only, into
// an 8-bit image.
layout(local_size_x = 64) in;

layout(constant_id = 0) const int FRAME_WIDTH = 728;
layout(constant_id = 1) const int FRAME_HEIGHT = 544;
layout(constant_id = 2) const int WIDTH = 364;
layout(constant_id = 3) const int HEIGHT = 272;
layout(constant_id = 4) const float SCALE_X = 2.0;
layout(constant_id = 5) const float SCALE_Y = 2.0;

layout(set = 0, binding = 0) readonly buffer Frame { uint frame[]; };
// k (3x3, row-major), d (k1, k2, p1, p2, k3), inverse_pr (3x3, row-major)
layout(set = 0, binding = 1) readonly buffer Camera { float camera[]; };
#if WORDS
layout(set = 0, binding = 2) writeonly buffer Image { int image[]; };
layout(set = 0, binding = 3) writeonly buffer Packed { uint packed[]; };
#else
layout(set = 0, binding = 2) writeonly buffer Packed { uint packed[]; };
#endif

// Outside the frame a neighbour reads 0, as OpenCV's BORDER_CONSTANT.
float sample_frame(int x, int y) {
  if (x < 0 || x >= FRAME_WIDTH || y < 0 || y >= FRAME_HEIGHT) return 0.0;
  uint i = uint(y * FRAME_WIDTH + x);
  return float((frame[i >> 2] >> ((i & 3u) * 8u)) & 255u);
}

uint rectified(int u_pixel, int v_pixel) {
  float u = float(u_pixel), v = float(v_pixel);
  float k00 = camera[0], k01 = camera[1], k02 = camera[2], k11 = camera[4], k12 = camera[5];
  float d0 = camera[9], d1 = camera[10], d2 = camera[11], d3 = camera[12], d4 = camera[13];

  precise float px = camera[14] * u + camera[15] * v + camera[16];
  precise float py = camera[17] * u + camera[18] * v + camera[19];
  precise float pw = camera[20] * u + camera[21] * v + camera[22];
  precise float x = px / pw;
  precise float y = py / pw;

  precise float r2 = x * x + y * y;
  precise float radial = 1.0 + d0 * r2 + d1 * r2 * r2 + d4 * r2 * r2 * r2;
  precise float xd = x * radial + 2.0 * d2 * x * y + d3 * (r2 + 2.0 * x * x);
  precise float yd = y * radial + d2 * (r2 + 2.0 * y * y) + 2.0 * d3 * x * y;

  precise float map_x = k00 * xd + k01 * yd + k02;
  precise float map_y = k11 * yd + k12;
  // Pixel centres line up, as in OpenCV's resize.
  precise float sx = (map_x + 0.5) * SCALE_X - 0.5;
  precise float sy = (map_y + 0.5) * SCALE_Y - 0.5;

  float x0f = floor(sx), y0f = floor(sy);
  precise float fx = sx - x0f;
  precise float fy = sy - y0f;
  int x0 = int(x0f), y0 = int(y0f);

  precise float top = (1.0 - fx) * sample_frame(x0, y0) + fx * sample_frame(x0 + 1, y0);
  precise float bottom = (1.0 - fx) * sample_frame(x0, y0 + 1) + fx * sample_frame(x0 + 1, y0 + 1);
  precise float value = (1.0 - fy) * top + fy * bottom;

  // Nx.round rounds halves away from zero; the value is never negative.
  return uint(clamp(floor(value + 0.5), 0.0, 255.0));
}

void main() {
  int word = int(gl_GlobalInvocationID.x);
  int y = int(gl_GlobalInvocationID.y);
  if (word >= WIDTH / 4 || y >= HEIGHT) return;

  uint bytes = 0u;
  for (int lane = 0; lane < 4; ++lane) {
    int x = word * 4 + lane;
    uint pixel = rectified(x, y);
#if WORDS
    image[y * WIDTH + x] = int(pixel);
#endif
    bytes |= pixel << (8 * lane);
  }
  packed[y * (WIDTH / 4) + word] = bytes;
}
